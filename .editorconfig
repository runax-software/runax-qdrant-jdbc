root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,yaml,yml,xml,toml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Windows scripts (gradlew.bat) need CRLF line endings
[*.bat]
end_of_line = crlf
