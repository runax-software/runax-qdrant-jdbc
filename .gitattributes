# Auto detect text files and normalise line endings to LF
* text=auto eol=lf

# Explicit text files
*.java text diff=java
*.kt text diff=kotlin
*.kts text diff=kotlin
*.properties text
*.json text
*.yaml text
*.yml text
*.xml text
*.toml text
*.md text
*.sh text eol=lf
gradlew text eol=lf

# Windows scripts need CRLF
*.bat text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.gif binary
*.ico binary
